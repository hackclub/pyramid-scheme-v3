<% content_for :title, "Pyramid Scheme V3 has ended" %>

<main class="min-h-[80svh] flex items-center justify-center px-6 py-16">
  <div class="max-w-2xl text-center">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-foreground">
      Pyramid Scheme V3 has ended!
    </h1>

    <p class="mt-6 text-base sm:text-lg text-muted-foreground">
      Join us at
      <%= link_to "Stardance", "https://stardance.hackclub.com/pyramid-v3", class: "font-semibold text-foreground underline underline-offset-4 hover:no-underline" %>
      for our next adventure, or check
      <%= link_to "Hack Club", "https://hackclub.com", class: "font-semibold text-foreground underline underline-offset-4 hover:no-underline" %>
      for our other programs!
    </p>

    <div class="mt-10">
      <%= link_to "Admin Login", auth_path, class: "inline-flex items-center justify-center rounded-lg border border-border px-4 py-2 text-sm font-semibold text-muted-foreground hover:text-foreground hover:border-foreground/40 transition-colors" %>
    </div>
  </div>
</main>
