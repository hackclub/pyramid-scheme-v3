<% content_for :title, "Referral Code Lookup" %>

<div class="mb-6">
  <h1 class="text-2xl font-bold tracking-tight text-foreground">Referral Code Lookup</h1>
  <p class="text-sm text-muted-foreground mt-1">Search any referral code to find its owner, history, and usage. Works with standard codes, custom codes, poster codes, and old codes.</p>
</div>

<div class="rounded-lg border border-border bg-card p-4 shadow-sm mb-6">
  <%= form_with url: admin_referral_lookup_path, method: :get, class: "flex gap-3" do %>
    <input type="text" name="code" value="<%= @code %>" autofocus
      class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm font-mono ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      placeholder="Enter referral code (e.g. AB12CD34 or mycustomcode)..." style="flex: 1;">
    <button type="submit" class="inline-flex items-center justify-center rounded-md px-6 py-2 text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
      Lookup
    </button>
  <% end %>
</div>

<% if @code.present? && @results %>
  <!-- Owner Information -->
  <div class="grid gap-6 lg:grid-cols-2 mb-6">
    <!-- Current Owner -->
    <div class="rounded-lg border border-border bg-card p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-foreground mb-4">Current Owner</h3>
      <% if @results[:current_user] %>
        <% user = @results[:current_user] %>
        <div class="flex items-center gap-3 mb-3">
          <% if user.avatar.present? %>
            <%= image_tag user.avatar, class: "w-10 h-10 rounded-full" %>
          <% end %>
          <div class="flex-1">
            <%= link_to user.display_name, admin_user_path(user), class: "font-medium text-foreground hover:text-primary" %>
            <div class="text-sm text-muted-foreground"><%= user.email %></div>
          </div>
          <%= link_to "View Profile", admin_user_path(user), class: "text-xs font-medium text-primary hover:underline" %>
        </div>
        <div class="grid grid-cols-2 gap-3 text-sm mt-4">
          <div>
            <span class="text-muted-foreground">Standard Code:</span>
            <span class="font-mono font-medium text-foreground ml-1"><%= user.referral_code %></span>
          </div>
          <div>
            <span class="text-muted-foreground">Custom Code:</span>
            <span class="font-mono font-medium text-foreground ml-1"><%= user.custom_referral_code || "—" %></span>
          </div>
          <div>
            <span class="text-muted-foreground">Referral Count:</span>
            <span class="font-medium text-foreground ml-1"><%= user.referral_count %></span>
          </div>
          <div>
            <span class="text-muted-foreground">Shards:</span>
            <span class="font-medium text-foreground ml-1"><%= user.total_shards %></span>
          </div>
        </div>
        <% match_type = if user.referral_code&.downcase == @code.downcase
            "standard code"
          elsif user.custom_referral_code&.downcase == @code.downcase
            "custom code"
          end %>
        <div class="mt-3 text-xs text-muted-foreground">Matched via: <span class="font-medium text-foreground"><%= match_type %></span></div>
      <% elsif @results[:historical_owner] %>
        <div class="text-sm text-yellow-500 font-medium mb-2">Not currently assigned — found via code history</div>
        <% user = @results[:historical_owner] %>
        <div class="flex items-center gap-3">
          <% if user.avatar.present? %>
            <%= image_tag user.avatar, class: "w-10 h-10 rounded-full" %>
          <% end %>
          <div class="flex-1">
            <%= link_to user.display_name, admin_user_path(user), class: "font-medium text-foreground hover:text-primary" %>
            <div class="text-sm text-muted-foreground"><%= user.email %></div>
          </div>
          <%= link_to "View Profile", admin_user_path(user), class: "text-xs font-medium text-primary hover:underline" %>
        </div>
        <div class="text-xs text-muted-foreground mt-2">This user previously used this code but has since changed it. Referrals using this code will still route to them.</div>
      <% else %>
        <div class="text-sm text-muted-foreground">No user found for this code.</div>
      <% end %>
    </div>

    <!-- Poster Match -->
    <div class="rounded-lg border border-border bg-card p-6 shadow-sm">
      <h3 class="text-lg font-semibold text-foreground mb-4">Poster Match</h3>
      <% if @results[:poster] %>
        <% poster = @results[:poster] %>
        <div class="space-y-2 text-sm">
          <div>
            <span class="text-muted-foreground">Poster ID:</span>
            <span class="font-medium text-foreground ml-1">#<%= poster.id %></span>
          </div>
          <div>
            <span class="text-muted-foreground">Owner:</span>
            <%= link_to poster.user.display_name, admin_user_path(poster.user), class: "font-medium text-primary hover:underline ml-1" %>
          </div>
          <div>
            <span class="text-muted-foreground">Campaign:</span>
            <span class="font-medium text-foreground ml-1"><%= poster.campaign&.name %></span>
          </div>
          <div>
            <span class="text-muted-foreground">Status:</span>
            <span class="font-medium text-foreground ml-1"><%= poster.verification_status.humanize %></span>
          </div>
          <div>
            <span class="text-muted-foreground">Scans:</span>
            <span class="font-medium text-foreground ml-1"><%= poster.poster_scans_count %></span>
          </div>
        </div>
      <% else %>
        <div class="text-sm text-muted-foreground">No poster found with this referral code.</div>
      <% end %>
    </div>
  </div>

  <!-- Code History -->
  <% if @results[:code_history]&.any? %>
    <div class="rounded-lg border border-border bg-card shadow-sm mb-6">
      <div class="p-6 border-b border-border">
        <h3 class="text-lg font-semibold text-foreground">Code History</h3>
        <p class="text-sm text-muted-foreground">Previous users of this code (from code changes).</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-border">
            <tr class="text-left text-xs text-muted-foreground">
              <th class="px-4 py-2">User</th>
              <th class="px-4 py-2">Type</th>
              <th class="px-4 py-2">Set At</th>
              <th class="px-4 py-2">Expired At</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @results[:code_history].each do |h| %>
              <tr class="hover:bg-muted/30">
                <td class="px-4 py-2">
                  <%= link_to h.user.display_name, admin_user_path(h.user), class: "font-medium text-foreground hover:text-primary" %>
                </td>
                <td class="px-4 py-2 text-muted-foreground"><%= h.code_type.humanize %></td>
                <td class="px-4 py-2 text-muted-foreground"><%= h.created_at.strftime("%b %d, %Y %H:%M") %></td>
                <td class="px-4 py-2 text-muted-foreground"><%= h.expired_at&.strftime("%b %d, %Y %H:%M") || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Referrals Using This Code -->
  <% if @results[:referrals_using_code]&.any? %>
    <div class="rounded-lg border border-border bg-card shadow-sm mb-6">
      <div class="p-6 border-b border-border">
        <h3 class="text-lg font-semibold text-foreground">Referrals by This User</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-border">
            <tr class="text-left text-xs text-muted-foreground">
              <th class="px-4 py-2">Referred</th>
              <th class="px-4 py-2">Campaign</th>
              <th class="px-4 py-2">Status</th>
              <th class="px-4 py-2">Type</th>
              <th class="px-4 py-2">Created</th>
              <th class="px-4 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @results[:referrals_using_code].each do |ref| %>
              <tr class="hover:bg-muted/30">
                <td class="px-4 py-2 text-foreground"><%= truncate(ref.referred_identifier, length: 30) %></td>
                <td class="px-4 py-2 text-muted-foreground"><%= ref.campaign.name %></td>
                <td class="px-4 py-2">
                  <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium <%= referral_status_badge_class(ref) %>">
                    <%= referral_status_label(ref) %>
                  </span>
                </td>
                <td class="px-4 py-2 text-muted-foreground"><%= ref.referral_type %></td>
                <td class="px-4 py-2 text-muted-foreground text-xs"><%= ref.created_at.strftime("%b %d") %></td>
                <td class="px-4 py-2 text-right">
                  <%= link_to "View", admin_referral_path(ref), class: "text-xs font-medium text-primary hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Airtable Referrals -->
  <% if @results[:airtable_referrals]&.any? %>
    <div class="rounded-lg border border-border bg-card shadow-sm mb-6">
      <div class="p-6 border-b border-border">
        <h3 class="text-lg font-semibold text-foreground">Airtable Referrals Using This Code</h3>
        <p class="text-sm text-muted-foreground">Records synced from Airtable with this referral code.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-border">
            <tr class="text-left text-xs text-muted-foreground">
              <th class="px-4 py-2">Email</th>
              <th class="px-4 py-2">Name</th>
              <th class="px-4 py-2">Campaign</th>
              <th class="px-4 py-2">Hours</th>
              <th class="px-4 py-2">IDV</th>
              <th class="px-4 py-2">Synced</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @results[:airtable_referrals].each do |ar| %>
              <tr class="hover:bg-muted/30">
                <td class="px-4 py-2 text-foreground font-mono text-xs"><%= truncate(ar.email, length: 30) %></td>
                <td class="px-4 py-2 text-foreground"><%= ar.name %></td>
                <td class="px-4 py-2 text-muted-foreground"><%= ar.campaign&.name || "—" %></td>
                <td class="px-4 py-2 text-muted-foreground"><%= ar.hours || "—" %></td>
                <td class="px-4 py-2 text-muted-foreground"><%= ar.idv_status || "—" %></td>
                <td class="px-4 py-2 text-muted-foreground text-xs">
                  <%= ar.synced_at&.strftime("%b %d, %Y") || "Never" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <!-- Recent Code Log Hits -->
  <% if @results[:code_logs]&.any? %>
    <div class="rounded-lg border border-border bg-card shadow-sm mb-6">
      <div class="p-6 border-b border-border">
        <h3 class="text-lg font-semibold text-foreground">Recent Proxy Hits</h3>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-border">
            <tr class="text-left text-xs text-muted-foreground">
              <th class="px-4 py-2">IP</th>
              <th class="px-4 py-2">Location</th>
              <th class="px-4 py-2">User Agent</th>
              <th class="px-4 py-2">When</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <% @results[:code_logs].each do |log| %>
              <tr class="hover:bg-muted/30">
                <td class="px-4 py-2 font-mono text-foreground text-xs"><%= log.ip_address %></td>
                <td class="px-4 py-2 text-muted-foreground"><%= [log.city, log.country_code].compact.join(", ").presence || "—" %></td>
                <td class="px-4 py-2 text-muted-foreground text-xs"><%= truncate(log.user_agent.to_s, length: 50) %></td>
                <td class="px-4 py-2 text-muted-foreground text-xs"><%= time_ago_in_words(log.created_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% if @results[:current_user].nil? && @results[:historical_owner].nil? && @results[:poster].nil? && @results[:airtable_referrals].blank? %>
    <div class="rounded-lg border border-border bg-card p-8 shadow-sm text-center">
      <div class="text-muted-foreground">
        <p class="text-lg font-medium mb-1">No results found for "<%= @code %>"</p>
        <p class="text-sm">This code doesn't match any user, poster, or historical referral code.</p>
      </div>
    </div>
  <% end %>
<% end %>
